# ---- 服务 ----
PORT=3000
HOST=0.0.0.0

# ---- 语音识别 ----
# 两种用法，由页面上的「语音识别设置」决定：
#   1) 站点服务：把 ASR_API_KEY 填在这里，访客什么都不用填（受下面的额度限制）；
#   2) 使用者自带 Key：留空 ASR_API_KEY，页面让用户填自己的 Key，服务端不持有任何密钥。
ASR_API_KEY=
# 站点自带密钥时的接口地址与模型，同时也是前端设置面板的默认值
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# 留空则自动识别语种；固定中文可填 zh
ASR_LANGUAGE=
# 并发提交的切片数，免费额度受限时建议 2-3
ASR_CONCURRENCY=3
# 允许前端填写的接口地址白名单补充项（防 SSRF），逗号分隔，支持 *.example.com
# 例如：ASR_EXTRA_HOSTS=asr.mycompany.com,*.internal-llm.cn
ASR_EXTRA_HOSTS=

# ---- 站点公共额度的限额（只在 ASR_API_KEY 有值时生效）----
# 同一个 IP 每小时可用站点服务的次数（防止单点刷量）
SITE_KEY_PER_IP_HOURLY=10
# 全站每天的总次数（防止被当成免费转写服务长期占用）
SITE_KEY_DAILY_TOTAL=100

# ---- 处理参数 ----
# 音频切片长度（秒），10-60。越短越准但请求数越多
SEGMENT_SECONDS=30
# 单个视频时长上限（秒）。默认 1800 = 30 分钟；超过直接拒绝，不白跑
MAX_VIDEO_SECONDS=1800
# 单个视频体积上限（MB）。下载途中边下边数，超限立刻中止
MAX_VIDEO_MB=300
# 同时处理的任务数上限
MAX_CONCURRENT_JOBS=4
# 抖音取流清晰度。只要音轨，所以默认取最低可用档（360p 会被回落成 1080p，480p 是实测最小档）
DOUYIN_RATIO=480p

# ---- 通用引擎 yt-dlp（可选）----
# 二进制路径。容器里由 docker-compose 把宿主机 ./bin 挂到 /app/bin
YTDLP_PATH=/app/bin/yt-dlp
# 取流格式：优先纯音频，其次不超过 480p 的合并流
YTDLP_FORMAT=ba/b[height<=480]/b
# 需要登录态的站点（小红书 / 西瓜 / 微博等）可挂一个浏览器导出的 Netscape 格式 cookies.txt
# 注意：这份文件会让服务端以你的账号身份请求，请只在自己的服务器上用
YTDLP_COOKIES=

# ---- 二进制路径（服务器上不在 PATH 时填写）----
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
